{
    "name": "griiv/synchroengine",
    "description": "Set of command and codes to create imports and exports",
    "type": "prestashop-module",
    "config": {
      "preferred-install": "dist",
      "optimize-autoloader": true,
      "prepend-autoloader": false
    },
    "autoload": {
        "files": [
            "bootstrap.php"
        ],
        "psr-4": {
            "Griiv\\SynchroEngine\\": "src/"
        },
      "classmap": ["griivsynchroengine.php"]
    },
    "authors": [
        {
            "name": "Arnaud Scoté",
            "email": "arnaud@griiv.fr"
        }
    ],
    "require": {
        "symfony/process": "^5.4",
        "monolog/monolog": "1.27.1"
    }
}
